{
    "name": "kristijorgji/php-support",
    "description": "Shared PHP primitives: major-unit Money (bcmath)",
    "type": "library",
    "version": "0.2.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristi Jorgji",
            "homepage": "https://www.kristijorgji.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "kristijorgji\\Money\\": "src/Money/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "kristijorgji\\Money\\Tests\\": "tests/Money/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
